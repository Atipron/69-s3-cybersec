# ==========================================
# 1. Database Configuration (.env.db)
# ==========================================
POSTGRES_DB=cybersec_db
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=your_postgres_admin_username
POSTGRES_SUPERUSER_PASSWORD=your_secure_postgres_admin_password
POSTGRES_USER=your_app_username
POSTGRES_PASSWORD=your_secure_app_password
DB_SSL_MODE=require

# ==========================================
# 2. Admin Service Configuration (.env.admin)
# ==========================================
NODE_ENV=production
ADMIN_PORT=8080
DB_HOST=db
DB_PORT=5432
DB_NAME=cybersec_db
DB_USER=your_postgres_admin_username
DB_PASSWORD=your_secure_postgres_admin_password
ADMIN_JWT_SECRET=your_random_admin_jwt_secret_key
SESSION_SECRET=your_random_admin_session_secret_key

# ==========================================
# 3. App Service Configuration (.env.app)
# ==========================================
NODE_ENV=production
APP_PORT=3000
DB_HOST=db
DB_PORT=5432
DB_NAME=cybersec_db
DB_USER=your_app_username
DB_PASSWORD=your_secure_app_password
APP_JWT_SECRET=your_random_app_jwt_secret_key
CORS_ORIGIN=http://localhost:3000